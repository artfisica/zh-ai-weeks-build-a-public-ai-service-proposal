{
  "name": "Apertus proxy",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [
    8787
  ],
  "portsAttributes": {
    "8787": {
      "label": "Apertus proxy",
      "onAutoForward": "silent"
    }
  },
  "secrets": {
    "APERTUS_API_KEY": {
      "description": "Swisscom (or Public AI) API key."
    },
    "UPSTREAM_BASE": {
      "description": "API base URL from the Swisscom guide, the part before /chat/completions (usually ends in /v1)."
    },
    "UPSTREAM_MODEL": {
      "description": "Apertus model id from the Swisscom guide."
    },
    "DEMO_TOKEN": {
      "description": "Optional. Leave unset for a public demo."
    }
  },
  "postStartCommand": "bash proxy/start.sh",
  "postAttachCommand": "cat /tmp/public-ai-commune-proxy.log"
}
